# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Supabase Postgres connection string (use the pooler/connection details for your runtime)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true
SESSION_SECRET=replace-with-a-long-random-secret
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
